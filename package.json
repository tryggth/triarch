{
  "name": "triarch-cyclic-edge",
  "version": "1.13.2",
  "description": "A strategic 3-player non-transitive tabletop game PWA powered by a verified mathematical dice engine",
  "type": "module",
  "main": "src/math/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "bundle": "node concat-source.js",
    "bump": "node scripts/bump-version.js && npm run bundle",
    "bump:minor": "node scripts/bump-version.js --minor && npm run bundle",
    "bump:major": "node scripts/bump-version.js --major && npm run bundle",
    "start": "python3 -m http.server 8080"
  },
  "keywords": [
    "pwa",
    "non-transitive-dice",
    "game-theory",
    "mathematics",
    "tabletop-game",
    "github-pages"
  ],
  "author": "Triarch Development Team",
  "license": "MIT"
}
